---
// Markup of the main page. Elements with data-i get their German text at build time, so the page reads well before the
// script runs (screen readers, search engines); the page script keeps them in sync with the chosen language.
// The data from src/content is validated here (a mistake stops the build with file and field) and embedded as JSON.
import raw from "./main.html?raw";
import { I18N } from "../lib/i18n.js";
import { loadContent } from "../lib/content.js";

const de = I18N.de;
const escapeHtml = (t) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const filled = raw.replace(/(<([a-z0-9]+)\b[^>]*\bdata-i="([A-Za-z0-9_]+)"[^>]*>)(<\/\2>)/g, (all, open, _tag, key, close) =>
  typeof de[key] === "string" ? open + escapeHtml(de[key]) + close : all,
);
// Empty lists are the default: leave them out to keep the page small. "<" is escaped so the JSON cannot end the script.
const json = JSON.stringify(loadContent(), (_key, value) =>
  Array.isArray(value) && value.length === 0 ? undefined : value,
).replace(/</g, "\\u003c");
---

<Fragment set:html={filled} />
<script type="application/json" id="app-data" set:html={json} />
